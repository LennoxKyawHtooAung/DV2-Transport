{
"$schema":"https://vega.github.io/schema/vega-lite/v5.json",

"width":500,
"height":360,

"title":"Transfer Count vs Travel Time",

"data":{
"url":"data/Fare_Time_Merged.csv"
},

"mark":"boxplot",

"encoding":{

"x":{

"field":"transfer_count",

"type":"ordinal",

"title":"Transfers"

},

"y":{

"field":"travel_time",

"type":"quantitative",

"title":"Travel Time (minutes)"

},

"color":{

"field":"same_line",

"type":"nominal",

"scale":{

"range":[
"#0072B2",
"#D55E00"
]

},

"title":"Same line?"
},

"tooltip":[

{"field":"origin"},

{"field":"destination"},

{"field":"travel_time"}

]

}

}