{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 350,
  "height": 300,
  "data": {
    "url": "data/population_district.csv"
  },
  "transform": [
    {
      "filter": "datum.sex == 'both' && datum.age == 'overall' && datum.ethnicity == 'overall' && datum.date == '2024-01-01'"
    },
    {
      "calculate": "toNumber(datum.population)",
      "as": "population_num"
    },
    {
      "calculate": "datum.population_num / 1000",
      "as": "population_million"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "population_num",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 25"
    },
    {
      "calculate": "datum.state == 'Selangor' || datum.state == 'W.P. Kuala Lumpur' || datum.state == 'W.P. Putrajaya' ? 'Klang Valley corridor' : 'Other districts'",
      "as": "district_group"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.35,
        "color": "#A8B8C8"
      },
      "encoding": {
        "x": {
          "field": "rank",
          "type": "quantitative",
          "title": "Population rank",
          "scale": {
            "domain": [1, 25]
          },
          "axis": {
            "tickMinStep": 1
          }
        },
        "y": {
          "field": "population_million",
          "type": "quantitative",
          "title": "Population (millions)",
          "scale": {
            "domain": [0, 2.6]
          }
        },
        "order": {
          "field": "rank",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "rank": 6.5,
            "population_million": 0
          },
          {
            "rank": 6.5,
            "population_million": 1.25
          }
        ]
      },
      "mark": {
        "type": "line",
        "strokeDash": [4, 4],
        "strokeWidth": 1,
        "color": "#555555"
      },
      "encoding": {
        "x": {
          "field": "rank",
          "type": "quantitative"
        },
        "y": {
          "field": "population_million",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 75,
        "opacity": 0.9,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "rank",
          "type": "quantitative",
          "title": "Population rank",
          "scale": {
            "domain": [1, 25]
          },
          "axis": {
            "tickMinStep": 1
          }
        },
        "y": {
          "field": "population_million",
          "type": "quantitative",
          "title": "Population (millions)",
          "scale": {
            "domain": [0, 2.6]
          }
        },
        "color": {
          "field": "district_group",
          "type": "nominal",
          "scale": {
            "domain": ["Klang Valley corridor", "Other districts"],
            "range": ["#2B6CB0", "#A8B8C8"]
          },
          "legend": {
            "title": null,
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "rank",
            "type": "ordinal",
            "title": "Rank"
          },
          {
            "field": "district",
            "type": "nominal",
            "title": "District"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "population_million",
            "type": "quantitative",
            "title": "Population (millions)",
            "format": ".2f"
          },
          {
            "field": "district_group",
            "type": "nominal",
            "title": "Group"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank <= 4"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 9,
        "fontWeight": "bold",
        "color": "#111111"
      },
      "encoding": {
        "x": {
          "field": "rank",
          "type": "quantitative"
        },
        "y": {
          "field": "population_million",
          "type": "quantitative"
        },
        "text": {
          "field": "district",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "rank": 7,
            "population_million": 1.3,
            "label": "After rank 6, districts fall below about 1.2M people"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 9,
        "fontWeight": "bold",
        "color": "#111111"
      },
      "encoding": {
        "x": {
          "field": "rank",
          "type": "quantitative"
        },
        "y": {
          "field": "population_million",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 11,
      "grid": true,
      "gridOpacity": 0.25
    },
    "title": {
      "fontSize": 14,
      "subtitleFontSize": 10,
      "anchor": "start"
    }
  }
}