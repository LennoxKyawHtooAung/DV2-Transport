{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 340,
  "data": {
    "url": "data/fare_time_route_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "fare_rm": "number",
        "time_min": "number",
        "transfer_count": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 58,
        "opacity": 0.48,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "time_min",
          "type": "quantitative",
          "title": "Travel time (minutes)",
          "scale": {
            "domain": [0, 110]
          }
        },
        "y": {
          "field": "fare_rm",
          "type": "quantitative",
          "title": "Fare (RM)",
          "scale": {
            "domain": [0, 8]
          },
          "axis": {
            "labelExpr": "'RM ' + format(datum.value, '.0f')"
          }
        },
        "color": {
          "field": "transfer_group",
          "type": "nominal",
          "title": "Journey type",
          "scale": {
            "domain": [
              "Direct journey",
              "1+ transfer"
            ],
            "range": [
              "#2A9D8F",
              "#F28E2B"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "origin",
            "type": "nominal",
            "title": "Origin"
          },
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "fare_label",
            "type": "nominal",
            "title": "Fare"
          },
          {
            "field": "time_label",
            "type": "nominal",
            "title": "Travel time"
          },
          {
            "field": "transfer_group",
            "type": "nominal",
            "title": "Journey type"
          },
          {
            "field": "route",
            "type": "nominal",
            "title": "Route"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "time_min": 19,
            "fare_rm": 2.2,
            "label": "Direct journeys cluster at lower fare and time"
          },
          {
            "time_min": 75,
            "fare_rm": 6.6,
            "label": "Transfer journeys form the upper-right tail"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#111111"
      },
      "encoding": {
        "x": {
          "field": "time_min",
          "type": "quantitative"
        },
        "y": {
          "field": "fare_rm",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 11,
      "grid": true,
      "gridOpacity": 0.22
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10
    },
    "title": {
      "fontSize": 14,
      "subtitleFontSize": 10,
      "anchor": "start"
    }
  }
}