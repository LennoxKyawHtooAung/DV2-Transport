{
"$schema":"https://vega.github.io/schema/vega-lite/v5.json",

"width":520,
"height":380,

"title":"Journey Time vs Fare",

"data":{
"url":"data/Fare_Time_Merged.csv"
},

"mark":{
"type":"circle",
"opacity":0.75,
"tooltip":true
},

"encoding":{

"x":{
"field":"travel_time",
"type":"quantitative",
"title":"Travel Time (minutes)"
},

"y":{
"field":"fare",
"type":"quantitative",
"title":"Fare (RM)"
},

"size":{
"field":"fare_per_minute",
"type":"quantitative",
"title":"Cost Efficiency"
},

"color":{
"field":"transfer_count",
"type":"ordinal",
"title":"Transfers",
"scale":{
"scheme":"blues"
}
},

"tooltip":[

{"field":"origin"},

{"field":"destination"},

{"field":"travel_time"},

{"field":"fare"},

{"field":"transfer_count"}

]

}

}