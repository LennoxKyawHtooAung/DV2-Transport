{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 410,
  "data": {
    "url": "data/rapidkl_od_matrix_top15.csv",
    "format": {
      "type": "csv",
      "parse": {
        "ridership": "number",
        "ridership_k": "number",
        "origin_rank": "number",
        "destination_rank": "number"
      }
    }
  },
  "params": [
    {
      "name": "MonthSelection",
      "value": "2026-04",
      "bind": {
        "input": "select",
        "options": [
          "2026-01",
          "2026-02",
          "2026-03",
          "2026-04",
          "2026-05"
        ],
        "name": "Month: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.month == MonthSelection"
    },
    {
      "calculate": "datum.origin == datum.destination || datum.origin_label == datum.destination_label",
      "as": "is_same_station"
    },
    {
      "calculate": "datum.is_same_station ? 'Same-station pair hidden from movement analysis' : 'Station-to-station passenger movement'",
      "as": "cell_type"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 0.6
  },
  "encoding": {
    "x": {
      "field": "destination_label",
      "type": "nominal",
      "title": "Destination",
      "sort": {
        "op": "min",
        "field": "destination_rank",
        "order": "ascending"
      },
      "axis": {
        "labelAngle": -45,
        "labelFontSize": 8,
        "labelLimit": 85
      }
    },
    "y": {
      "field": "origin_label",
      "type": "nominal",
      "title": "Origin",
      "sort": {
        "op": "min",
        "field": "origin_rank",
        "order": "ascending"
      },
      "axis": {
        "labelFontSize": 8,
        "labelLimit": 95
      }
    },
    "color": {
      "condition": {
        "test": "datum.is_same_station",
        "value": "#ffffff"
      },
      "field": "ridership",
      "type": "quantitative",
      "title": "Monthly ridership",
      "scale": {
        "range": [
          "#E6F4F1",
          "#A9DCD5",
          "#0F4C45"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 230,
        "labelExpr": "datum.value >= 1000000 ? format(datum.value/1000000, '.1f') + 'M' : format(datum.value/1000, '.0f') + 'K'"
      }
    },
    "tooltip": [
      {
        "field": "month",
        "type": "nominal",
        "title": "Month"
      },
      {
        "field": "origin",
        "type": "nominal",
        "title": "Origin"
      },
      {
        "field": "destination",
        "type": "nominal",
        "title": "Destination"
      },
      {
        "field": "origin_line",
        "type": "nominal",
        "title": "Origin line"
      },
      {
        "field": "destination_line",
        "type": "nominal",
        "title": "Destination line"
      },
      {
        "field": "flow_type",
        "type": "nominal",
        "title": "Flow type"
      },
      {
        "field": "cell_type",
        "type": "nominal",
        "title": "Matrix cell type"
      },
      {
        "field": "ridership",
        "type": "quantitative",
        "title": "Monthly ridership",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "titleFontSize": 11,
      "labelFontSize": 9,
      "grid": false
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10
    }
  }
}